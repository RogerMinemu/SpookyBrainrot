# Copy to .env (blocked name by permission rules in the dev env: file is env.example)
# Port: SERVER_PORT wins, then PORT, then 8000
SERVER_PORT=
PORT=
# Public base URL encoded in the QR codes (no trailing slash needed)
PUBLIC_URL=http://localhost:8000
DB_PATH=data/spooky.db
# Optional: protects /admin/* and /api/house*
ADMIN_KEY=
# Minimum connected players to leave the lobby
MIN_PLAYERS=2
